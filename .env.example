# Common configuration
APP_ENV=development
SECRET_KEY=your_secure_random_key_here_at_least_32_characters_long
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=3600
LOG_LEVEL=INFO
BASE_URL=http://localhost:5000
# 对外展示地址（反向代理后的公网域名），用于生成链接。
PUBLIC_BASE_URL=
# 钉钉等外部通知里"查看详情"链接的基地址；优先级高于 PUBLIC_BASE_URL/BASE_URL。
# 仅用于生成展示链接，服务端不会请求该地址；只接受 http/https。
DING_TALK_DETAIL_BASE_URL=http://param.jaspil.cn
# 股票主站服务基地址（app/remote_api 统一 HTTP 出口唯一消费方：
# 数据层仓储 / K线库读写 / 参数回推 / 代理池 全部经它发请求）。
# 留空时远程数据访问不可用（发请求即抛 RemoteApiConfigError）。
STOCK_BASE_URL=https://stockapi.jaspil.cn
# 主站部署在内网（域名解析为私网地址）时置 true，放行 SSRF 校验的私网网段；
# 默认 false：基地址解析到环回/私有/保留地址直接拒绝启动数据访问。
STOCK_BASE_URL_ALLOW_PRIVATE=false
# 远程数据服务凭据（只能来自环境变量/密钥服务，禁止写入源码或提交本文件）。
# STOCK_API_TOKEN：服务级凭据（SysUser/Login 颁发的 Token），是后台任务线程、
#   启动钩子与业务 API 数据访问的唯一凭据来源（用户 Token 只用于身份/菜单校验）。
#   必须配置，否则 http 模式下所有数据访问 401。
# STOCK_API_USERNAME / STOCK_API_PASSWORD：可选兜底。服务级 Token 失效（远端
#   401）时，统一调用器自动用该账号重登换新 Token 并重试一次；两者任一留空
#   则不启用自动重登（沿用 401 抛错）。
STOCK_API_TOKEN=
STOCK_API_USERNAME=
STOCK_API_PASSWORD=
SQLALCHEMY_ECHO=False
FLASK_DEBUG=False
DATABASE_URL=postgresql://validator_user:validator_password@127.0.0.1:5432/googlesheet_validator

# Auth（仅本地/测试可设 false；false 时全局网关注入匿名 mock 用户，生产必须 true）
AUTH_ENABLED=true

DING_TALK_ACCESS_TOKEN=your_ding_talk_access_token
DING_TALK_SECRET=your_ding_talk_secret

# DingTalk stream microservice
DING_STREAM_CLIENT_ID=your_ding_stream_client_id
DING_STREAM_CLIENT_SECRET=your_ding_stream_client_secret
# 钉钉微服务 → Web 内部重启/取消命令共享密钥；留空时 Web 端点 404。
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
INTERNAL_COMMAND_SECRET=

# JWT 签名密钥（必填）：生产/开发各用独立强随机值，缺失时进程内随机生成（重启后令牌失效）。
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
# 注意：留空走随机兜底；切勿填公开示例占位串（会被直接当密钥使用且无告警）。
JWT_SECRET_KEY=
