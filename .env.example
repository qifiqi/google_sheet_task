# Common configuration
APP_ENV=development
SECRET_KEY=your_secure_random_key_here_at_least_32_characters_long
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=3600
LOG_LEVEL=INFO
BASE_URL=http://localhost:5000
PUBLIC_BASE_URL=
DING_TALK_DETAIL_BASE_URL=
# 股票服务基地址：K线 SDK(StockClient) / 参数回推(StockAPIClient) / 代理池(SmartProxyManager) 共用。
# 留空时 K线 SDK 用 stock_sdk 内置默认地址，参数回推与代理池回退 http://stockapi.stplan.cn。
STOCK_BASE_URL=http://stockapi.stplan.cn
SQLALCHEMY_ECHO=False
FLASK_DEBUG=False
DATABASE_URL=postgresql://validator_user:validator_password@127.0.0.1:5432/googlesheet_validator

# Auth
AUTH_ENABLED=false

DING_TALK_ACCESS_TOKEN=your_ding_talk_access_token
DING_TALK_SECRET=your_ding_talk_secret

# DingTalk stream microservice
DING_STREAM_CLIENT_ID=your_ding_stream_client_id
DING_STREAM_CLIENT_SECRET=your_ding_stream_client_secret

# JWT 签名密钥（必填）：生产/开发各用独立强随机值，缺失时进程内随机生成（重启后令牌失效）。
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
# 注意：留空走随机兜底；切勿填公开示例占位串（会被直接当密钥使用且无告警）。
JWT_SECRET_KEY=
